    {
      "declarations": [
        "input seconds",
        "input reason",
        "local secondsPlural = seconds: plural"
      ],
      "selectors": [
        "secondsPlural"
      ],
      "match": {
        "secondsPlural=one": "{reason} · Reconnecting in {seconds} second",
        "secondsPlural=*": "{reason} · Reconnecting in {seconds} seconds"
      }
    }
  ],
  "status_last_price": [
    {
      "declarations": [
        "input seconds",
        "input price",
        "local secondsPlural = seconds: plural"
      ],
      "selectors": [
        "secondsPlural"
      ],
      "match": {
        "secondsPlural=one": "Last price {price}, {seconds} second ago",
        "secondsPlural=*": "Last price {price}, {seconds} seconds ago"
      }
    }
  ],
