{
  "name": "coinboard",
  "version": "0.27.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Real-time crypto price board",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "vite build && node tests/e2e/run.js",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy preferredLanguage baseLocale --silent",
    "pretest": "npm run -s i18n",
    "icons": "node scripts/icons.js"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/svelte": "1.1.5",
    "@inlang/paraglide-js": "3.2.2",
    "@internationalized/date": "3.12.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "bits-ui": "2.21.0",
    "clsx": "2.1.1",
    "playwright": "1.65.1",
    "shadcn-svelte": "1.8.1",
    "svelte": "^5.57.3",
    "svelte-sonner": "1.2.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.2",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "^8.3.8"
  }
}
