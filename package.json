{
  "name": "coinboard",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Real-time crypto price board",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "vite build && node tests/e2e/run.js",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy preferredLanguage baseLocale --silent",
    "pretest": "npm run -s i18n"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "playwright": "1.65.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.8"
  }
}
